{
  "manifest_version": 3,
  "name": "GameSheet Assistant Web Helper",
  "version": "0.1.0",
  "description": "Fills a reviewed GameSheet Edit Game form from GameSheet Assistant data.",
  "permissions": ["activeTab", "clipboardRead"],
  "host_permissions": ["https://*.gamesheet.app/*"],
  "action": {"default_title": "Fill GameSheet", "default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://*.gamesheet.app/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
